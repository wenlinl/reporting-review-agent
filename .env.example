# ---- 必填 ----
# 登录会话密钥：生成方式 `openssl rand -hex 32`
AUTH_SECRET=please-change-me

# SQLite 数据库文件路径（相对 prisma 目录）
DATABASE_URL="file:../data/app.db"

# 文件存储目录（扫描图片等上传文件）
DATA_DIR="./data/uploads"

# ---- 字节火山方舟（豆包大模型）----
# https://console.volcengine.com/ark 创建 API Key
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 填写你在方舟控制台开通的模型 ID（如 deepseek-v4-flash-ga-260731）或推理接入点 ID（ep-xxx）
ARK_CHAT_MODEL=deepseek-v4-flash-ga-260731

# ---- 初始管理员账号（pnpm db:seed 使用）----
SEED_ADMIN_NAME=管理员
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123!

# ---- 鲜知道：图片识别视觉模型（火山方舟）----
# 图片解析用视觉模型；不填则回退 ARK_API_KEY / ARK_CHAT_MODEL（注意文本模型可能不支持图片）
ARK_VISION_API_KEY=
ARK_VISION_MODEL=doubao-seed-2-1-turbo-260628
