# ---- 必填 ----
# 登录会话密钥：生成方式 `openssl rand -hex 32`
AUTH_SECRET=please-change-me

# SQLite 数据库文件路径（相对 prisma 目录）
DATABASE_URL="file:../data/app.db"

# 文件存储目录（PPT / 录音）
DATA_DIR="./data/uploads"

# ---- 字节火山方舟（豆包大模型）----
# https://console.volcengine.com/ark 创建 API Key
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 填写你在方舟控制台开通的模型 ID（如 deepseek-v4-flash-ga-260731）或推理接入点 ID（ep-xxx）
ARK_CHAT_MODEL=deepseek-v4-flash-ga-260731

# ---- 字节火山引擎语音识别（录音转写）----
# https://console.volcengine.com/speech 语音服务 → 大模型 ASR，新版控制台使用 API Key
VOLC_SPEECH_API_KEY=
# 旧版控制台可选：App ID
VOLC_SPEECH_APP_ID=
# flash=极速版（同步，适合 10 分钟音频）| standard=标准版（异步轮询）
VOLC_ASR_MODE=flash
# 极速版资源 ID（默认 volc.bigasr.auc_turbo）；标准版用 volc.seedasr.auc（2.0）或 volc.bigasr.auc
# VOLC_ASR_RESOURCE_ID=volc.bigasr.auc_turbo

# ---- 实时转写（演讲现场边讲边上字幕）----
# 使用豆包大模型流式语音识别（WebSocket V3）。默认走 ASR 2.0（含断句+说话人），
# 若账号未开通 2.0 会自动降级 ASR 1.0（无说话人）。也可手动指定：
# VOLC_STREAM_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
# VOLC_STREAM_ASR_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async

# ---- 反馈语音播放（AI 评论 → 语音合成）----
# 优先使用 TTS API Key；不填则复用 VOLC_SPEECH_API_KEY（需账号开通语音合成大模型）。
# 未配置或未开通时，页面会自动降级为浏览器本地语音朗读。
# VOLC_TTS_API_KEY=
# VOLC_TTS_RESOURCE_ID=seed-tts-2.0
# VOLC_TTS_VOICE=zh_female_vv_uranus_bigtts
# VOLC_TTS_FORMAT=mp3

# ---- 初始管理员账号（pnpm db:seed 使用）----
SEED_ADMIN_NAME=管理员
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123!

# 站点地址（部署后填写，如 https://your-domain.com）
APP_URL=http://localhost:3000

# ---- 鲜知道：图片识别视觉模型（火山方舟）----
# 图片解析用视觉模型；不填则回退 ARK_CHAT_MODEL（注意文本模型可能不支持图片）
ARK_VISION_MODEL=doubao-seed-2-1-turbo-260628
