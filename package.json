{
  "name": "shike-server",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"tests/*.test.ts\"",
    "db:push": "mkdir -p data && touch data/app.db && prisma db push",
    "db:migrate": "mkdir -p data && touch data/app.db && prisma migrate dev",
    "db:seed": "mkdir -p data && tsx prisma/seed.ts",
    "db:seed:shike": "mkdir -p data && tsx prisma/seed-shike.ts",
    "db:devices": "tsx prisma/seed-device-tokens.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^3.0.2",
    "busboy": "^1.6.0",
    "jose": "^5.9.6",
    "next": "^15.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.8",
    "@types/busboy": "^1.5.4",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "prisma": "^6.5.0",
    "tailwindcss": "^4.1.8",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
