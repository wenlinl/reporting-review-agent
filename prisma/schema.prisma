generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==================== 账号体系（食刻） ====================

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("user") // admin | user
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  member       Member?
}

model Family {
  id         String   @id @default(cuid())
  name       String
  inviteCode String   @unique
  createdAt  DateTime @default(now())
  members    Member[]
}

model Member {
  id                  String   @id @default(cuid())
  userId              String?  @unique // 关联网站账号（注册时自动创建）
  user                User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  familyId            String?  // 所属家庭；null = 尚未加入家庭
  family              Family?  @relation(fields: [familyId], references: [id], onDelete: SetNull)
  name                String
  role                String   @default("member") // admin(家庭创建者) | member
  avatar              String?
  responsibleCategory String?
  preferences         String?  // JSON：["清淡","家常"]
  createdAt           DateTime @default(now())

  @@index([familyId])
}

// ==================== 设备 ====================

model Device {
  id              String    @id @default(cuid())
  deviceId        String    @unique
  tokenHash       String?   // 设备 Token 的 bcrypt 哈希（固件 X-Device-Token 校验）
  familyId        String?   // 设备归属家庭（扫描入库归属该家庭）
  name            String?
  firmwareVersion String?
  memberId        String?
  lastSeenAt      DateTime?
  createdAt       DateTime  @default(now())
}

model DeviceLog {
  id        String   @id @default(cuid())
  deviceId  String
  event     String
  msg       String?
  createdAt DateTime @default(now())

  @@index([deviceId, createdAt])
}

model TemperatureLog {
  id        String   @id @default(cuid())
  deviceId  String
  tempC     Float
  readAt    DateTime
  createdAt DateTime @default(now())

  @@index([deviceId, readAt])
}

// ==================== 容器 / 食材 ====================

model Container {
  id        String   @id @default(cuid())
  name      String   @unique
  icon      String?
  sort      Int      @default(0)
  builtIn   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model FoodCatalog {
  id                 String   @id @default(cuid())
  name               String   @unique
  category           String?
  emoji              String?
  keepDays           Int?
  defaultExpiryDays  Int?
  suggestedContainer String?
  aliases            String?  // JSON 数组
  nutrition          String?  // JSON：{ protein, vitaminC, fiber, calcium }
  source             String   @default("ai") // ai | manual
  correctedAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model FoodItem {
  id           String    @id @default(cuid())
  deviceId     String
  familyId     String?
  memberId     String?
  name         String
  category     String?
  emoji        String?
  container    String
  quantity     Int       @default(1)
  recordMethod String    @default("camera") // camera | manual
  keepDays     Int?
  storage      String?   // 保鲜中 | 冷藏中 | 冷冻 | 常温
  label        String?
  scannedAt    DateTime
  expiryDate   DateTime?
  daysLeft     Int
  confidence   Float
  note         String?
  imagePath    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([name, container, deviceId])
  @@index([container])
}

model ScanLog {
  id           String   @id @default(cuid())
  deviceId     String
  requestId    String?  @unique // 固件幂等键：网络重试不会重复入库
  familyId     String?
  memberId     String?
  action       String // in | out
  name         String
  category     String?
  emoji        String?
  container    String
  quantity     Int      @default(1)
  recordMethod String   @default("camera")
  keepDays     Int?
  scannedAt    DateTime
  expiryDate   DateTime?
  daysLeft     Int
  confidence   Float
  note         String?
  imagePath    String?
  createdAt    DateTime @default(now())

  @@index([scannedAt])
  @@index([container])
}

model FoodTrace {
  id        String    @id @default(cuid())
  itemId    String    @unique
  source    String?
  origin    String?
  batch     String?
  coldChain String?
  report    String?
  inTime    DateTime?
  createdAt DateTime  @default(now())
}

// ==================== 购物 / 通知 / 消耗 ====================

model ShoppingListItem {
  id        String    @id @default(cuid())
  familyId  String?
  name      String
  qty       Int       @default(1)
  unit      String?
  done      Boolean   @default(false)
  suggested Boolean   @default(false)
  source    String    @default("manual") // manual | expiry | recipe
  boughtAt  DateTime?
  createdAt DateTime  @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  familyId  String?
  type      String   // expiry | recipe | member | shop | system
  title     String
  desc      String?
  unread    Boolean  @default(true)
  view      String?
  createdAt DateTime @default(now())
}

model ReminderRecord {
  id           String    @id @default(cuid())
  type         String
  scheduledFor DateTime
  payload      String?
  pushedAt     DateTime?
  createdAt    DateTime  @default(now())

  @@unique([type, scheduledFor])
}

model ReminderSetting {
  id       String @id @default(cuid())
  familyId String?
  key      String
  value    String // JSON

  @@unique([familyId, key])
}

model ConsumptionLog {
  id        String   @id @default(cuid())
  familyId  String?
  name      String
  reason    String   // consumed | wasted | expired
  quantity  Int      @default(1)
  memberId  String?
  note      String?
  createdAt DateTime @default(now())
}

// ==================== 菜谱 ====================

model Recipe {
  id          String   @id @default(cuid())
  name        String   @unique
  emoji       String?
  grad        String?
  tag         String?
  timeMin     Int?
  desc        String?
  nutr        String?  // JSON
  ingredients String   // JSON：[{ name, qty, status: 有|缺 }]
  steps       String?  // JSON 数组
  tags        String?  // JSON 数组
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WeeklyMealPlan {
  id        String   @id @default(cuid())
  familyId  String?
  weekStart DateTime
  date      DateTime
  recipeId  String
  status    String   @default("planned")
  createdAt DateTime @default(now())

  @@unique([date, recipeId])
}

model RecipePreference {
  id           String    @id @default(cuid())
  familyId     String?   // 收藏按家庭隔离
  recipeId     String
  liked        Boolean   @default(false)
  rating       Int?
  timesCooked  Int       @default(0)
  lastCookedAt DateTime?
  updatedAt    DateTime  @updatedAt

  @@unique([recipeId, familyId])
}
